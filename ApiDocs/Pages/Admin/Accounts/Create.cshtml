@page
@model ApiDocs.Pages.Admin.Accounts.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tạo tài khoản";
    ViewData["Crumb"] = "Khách hàng gắn một dự án; nội bộ do administrator trung tâm tạo";
    ViewData["Nav"] = "accounts";
}
<partial name="_Flash" model="@((Model.Flash, Model.FlashError))" />
@if (Model.Options != null)
{
    <form method="post" class="adm__form" autocomplete="off">
        <label for="Input_Login">Tên đăng nhập</label>
        <input id="Input_Login" name="Input.Login" value="@Model.Input.Login" maxlength="64" required />
        <label for="Input_DisplayName">Tên hiển thị</label>
        <input id="Input_DisplayName" name="Input.DisplayName" value="@Model.Input.DisplayName" maxlength="100" required />
        <label for="Input_Kind">Loại tài khoản</label>
        <select id="Input_Kind" name="Input.Kind">
            <option value="customer" selected="@(Model.Input.Kind != "staff")">Khách hàng (partner)</option>
            @if (Model.Options.CanCreateStaff)
            {
                <option value="staff" selected="@(Model.Input.Kind == "staff")">Nội bộ (staff)</option>
            }
        </select>
        <label for="Input_RoleCode">Vai trò (khách hàng luôn là partner)</label>
        <select id="Input_RoleCode" name="Input.RoleCode">
            <option value="partner">partner</option>
            @if (Model.Options.CanCreateStaff)
            {
                <option value="deployment" selected="@(Model.Input.RoleCode == "deployment")">deployment</option>
                <option value="administrator" selected="@(Model.Input.RoleCode == "administrator")">administrator</option>
            }
        </select>
        <label for="Input_ProjectId">Dự án (administrator để trống = mọi dự án)</label>
        <select id="Input_ProjectId" name="Input.ProjectId">
            <option value="">(không)</option>
            @foreach (var project in Model.Options.Projects)
            {
                <option value="@project.Id" selected="@(Model.Input.ProjectId == project.Id)">@project.Code - @project.Name</option>
            }
        </select>
        <label for="Input_ProjectUser">Tài khoản API của khách trong dự án (tùy chọn)</label>
        <input id="Input_ProjectUser" name="Input.ProjectUser" value="@Model.Input.ProjectUser" maxlength="32" />
        <label for="Input_Password">Mật khẩu ban đầu (tối thiểu 12 ký tự, giao cho người dùng rồi nhờ đổi ở mục Đổi mật khẩu)</label>
        <input id="Input_Password" name="Input.Password" type="password" maxlength="256" autocomplete="new-password" required />
        <button type="submit" class="adm__btn">Tạo tài khoản</button>
    </form>
}
