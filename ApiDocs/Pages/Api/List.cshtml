@page
@model ApiDocs.Pages.Api.ListModel
<div class="container mx-auto px-4 py-6">
    <h1 class="text-3xl font-bold mb-6">📜 Danh sách API</h1>

    <div class="grid gap-4">
        @foreach (var api in Model.ApiList)
        {
            <div class="bg-white shadow-md rounded-2xl p-4 hover:bg-gray-50 transition">
                <div class="flex justify-between items-center">
                    <div>
                        <p class="text-sm text-gray-500">@api.Group</p>
                        <h2 class="text-xl font-semibold">@api.Name</h2>
                        <p class="text-sm text-gray-600">@api.Description</p>
                        <p class="text-sm mt-1"><span class="font-bold">Route:</span> <code class="bg-gray-100 px-2 py-1 rounded">@api.Route</code></p>
                    </div>
                    <div class="text-right">
                        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium
                                    @(api.Method == "GET" ? "bg-green-100 text-green-800"
                                                                                        : api.Method == "POST" ? "bg-blue-100 text-blue-800"
                                                                                        : api.Method == "PUT" ? "bg-yellow-100 text-yellow-800"
                                                                                        : "bg-red-100 text-red-800")">
                        @api.Method
                    </span>
                    <div class="mt-3">
                        <a href="/Api/Detail?route=@api.Route" class="text-blue-600 hover:underline text-sm">🔍 Xem chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
                }
    </div>
</div>
