@model bool
@if (Model)
{
    <p class="adm__warn">Bạn phải đổi mật khẩu ban đầu trước khi tiếp tục.</p>
}
<form method="post" class="adm__form">
    <label for="current">Mật khẩu hiện tại</label>
    <input id="current" name="current" type="password" maxlength="256" autocomplete="current-password" required />
    <label for="next">Mật khẩu mới (tối thiểu 12 ký tự)</label>
    <input id="next" name="next" type="password" minlength="12" maxlength="256" autocomplete="new-password" required />
    <button type="submit" class="adm__btn">Đổi mật khẩu</button>
</form>
<p class="adm__crumb">Đổi xong mọi phiên đang mở bị kết thúc, bạn đăng nhập lại bằng mật khẩu mới.</p>
