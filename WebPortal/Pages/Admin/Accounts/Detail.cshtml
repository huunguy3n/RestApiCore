@page "{id:int}"
@model WebPortal.Pages.Admin.Accounts.DetailModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Detail?.Account.Login ?? "Tài khoản";
    ViewData["Crumb"] = "Chi tiết tài khoản";
    ViewData["Nav"] = "accounts";
}
<partial name="_Flash" model="@((Model.Flash, Model.FlashError))" />
@if (Model.Detail != null)
{
    var d = Model.Detail;
    <section class="adm__panel">
        <h2>@d.Account.DisplayName <span class="adm__chip">@(d.Account.Kind == "staff" ? "Nội bộ" : "Khách hàng")</span> <span class="adm__chip">@(d.Account.Active ? "Hoạt động" : "Đã khóa")</span></h2>
        <p class="adm__crumb">Tên đăng nhập: @d.Account.Login</p>
        @if (d.CanLock)
        {
            <form method="post" asp-page-handler="SetActive" asp-route-id="@d.Account.Id" class="adm__inline">
                <input type="hidden" name="active" value="@(d.Account.Active ? "false" : "true")" />
                <button type="submit" class="adm__btn adm__btn--ghost">@(d.Account.Active ? "Khóa tài khoản" : "Mở khóa")</button>
            </form>
        }
    </section>

    <section class="adm__panel">
        <h2>Phân quyền theo dự án</h2>
        <table class="adm__table">
            <thead><tr><th>Dự án</th><th>Vai trò</th><th>Tài khoản API</th><th></th></tr></thead>
            <tbody>
            @foreach (var m in d.Memberships)
            {
                <tr>
                    <td>@(m.ProjectId == null ? "Mọi dự án" : (m.ProjectCode ?? "(dự án ngừng)"))</td>
                    <td>@m.RoleCode</td>
                    <td>@m.ProjectUserName</td>
                    <td>
                        @if (m.CanRemove)
                        {
                            <form method="post" asp-page-handler="RemoveMembership" asp-route-id="@d.Account.Id" class="adm__inline">
                                <input type="hidden" name="membershipId" value="@m.Id" />
                                <button type="submit" class="adm__btn adm__btn--small adm__btn--ghost">Gỡ</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (d.Memberships.Count == 0)
            {
                <tr><td colspan="4" class="adm__empty">Chưa có phân quyền.</td></tr>
            }
            </tbody>
        </table>

        @if (d.AssignableProjects.Count > 0 || d.CanAssignStaffRoles)
        {
            <form method="post" asp-page-handler="AddMembership" asp-route-id="@d.Account.Id" class="adm__bar">
                <select name="projectId" aria-label="Dự án">
                    @if (d.CanAssignStaffRoles) { <option value="">Mọi dự án (chỉ administrator)</option> }
                    @foreach (var p in d.AssignableProjects) { <option value="@p.Id">@p.Code - @p.Name</option> }
                </select>
                <select name="roleCode" aria-label="Vai trò">
                    @if (d.Account.Kind == "customer") { <option value="partner">partner</option> }
                    else { <option value="deployment">deployment</option><option value="administrator">administrator</option> }
                </select>
                @if (d.Account.Kind == "customer") { <input name="projectUser" maxlength="32" placeholder="Tài khoản API (tùy chọn)" aria-label="Tài khoản API" /> }
                <button type="submit" class="adm__btn">Thêm</button>
            </form>
        }
    </section>
}
<p><a asp-page="Index">← Danh sách tài khoản</a></p>
