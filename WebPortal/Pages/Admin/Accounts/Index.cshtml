@page
@model WebPortal.Pages.Admin.Accounts.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tài khoản";
    ViewData["Crumb"] = "Nội bộ và khách hàng";
    ViewData["Nav"] = "accounts";
}
<partial name="_Flash" model="@((Model.Flash, Model.FlashError))" />
@if (Model.Page_ != null)
{
    <form method="get" class="adm__bar">
        <input name="search" value="@Model.Search" maxlength="64" placeholder="Tìm theo tên đăng nhập hoặc tên hiển thị" aria-label="Tìm kiếm" />
        <button type="submit" class="adm__btn">Tìm</button>
        @if (Model.CanCreate)
        {
            <a class="adm__btn adm__btn--ghost" asp-page="Create">Tạo tài khoản</a>
        }
    </form>
    <table class="adm__table">
        <thead><tr><th>Tên đăng nhập</th><th>Tên hiển thị</th><th>Loại</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model.Page_.Items)
        {
            <tr>
                <td>@item.Login</td>
                <td>@item.DisplayName</td>
                <td><span class="adm__chip">@(item.Kind == "staff" ? "Nội bộ" : "Khách hàng")</span></td>
                <td>@(item.Active ? "Hoạt động" : "Đã khóa")</td>
                <td><a asp-page="Detail" asp-route-id="@item.Id">Chi tiết</a></td>
            </tr>
        }
        @if (Model.Page_.Items.Count == 0)
        {
            <tr><td colspan="5" class="adm__empty">Không có tài khoản phù hợp.</td></tr>
        }
        </tbody>
    </table>
    <p class="adm__crumb">
        @Model.Page_.Total tài khoản · trang @Model.PageNumber
        @if (Model.PageNumber > 1) { <a asp-page="Index" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber - 1)">Trước</a> }
        @if (Model.PageNumber * 25 < Model.Page_.Total) { <a asp-page="Index" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber + 1)">Sau</a> }
    </p>
}
