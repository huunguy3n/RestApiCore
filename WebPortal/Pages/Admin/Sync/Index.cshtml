@page
@model WebPortal.Pages.Admin.Sync.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhật ký đồng bộ";
    ViewData["Crumb"] = "Xuất gói ở portal, áp gói ở môi trường bằng CLI rồi nhập kết quả về đây";
    ViewData["Nav"] = "sync";
}
<partial name="_Flash" model="@((Model.Flash, Model.FlashError))" />
<form method="get" class="adm__bar">
    <select name="projectId" aria-label="Dự án">
        <option value="">Mọi dự án</option>
        @foreach (var p in Model.Projects)
        {
            <option value="@p.Id" selected="@(Model.ProjectId == p.Id)">@p.Code</option>
        }
    </select>
    <select name="env" aria-label="Môi trường">
        <option value="">DEV + PROD</option>
        <option value="DEV" selected="@(Model.Env == "DEV")">DEV</option>
        <option value="PROD" selected="@(Model.Env == "PROD")">PROD</option>
    </select>
    <select name="outcome" aria-label="Kết quả">
        <option value="">Mọi kết quả</option>
        <option value="OK" selected="@(Model.Outcome == "OK")">OK</option>
        <option value="FAILED" selected="@(Model.Outcome == "FAILED")">FAILED</option>
    </select>
    <button type="submit" class="adm__btn">Lọc</button>
</form>

@if (Model.Log != null)
{
    <table class="adm__table">
        <thead><tr><th>Thời gian</th><th>Dự án</th><th>Môi trường</th><th>Sự kiện</th><th>Gói</th><th>Nguồn</th><th>Người</th><th>Kết quả</th><th>Chi tiết</th></tr></thead>
        <tbody>
        @foreach (var e in Model.Log.Items)
        {
            <tr>
                <td>@e.At.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@e.ProjectCode</td>
                <td>@e.Env</td>
                <td>@e.Event</td>
                <td>@(e.PackageId != null ? "#" + e.PackageId : "")</td>
                <td>@e.Source</td>
                <td>@e.Actor</td>
                <td><span class="adm__chip adm__chip--@(e.Outcome == "OK" ? "success" : "denied")">@e.Outcome</span></td>
                <td>@e.Detail</td>
            </tr>
        }
        @if (Model.Log.Items.Count == 0)
        {
            <tr><td colspan="9" class="adm__empty">Chưa có sự kiện đồng bộ.</td></tr>
        }
        </tbody>
    </table>
    <p class="adm__crumb">
        @Model.Log.Total sự kiện · trang @Model.PageNumber
        @if (Model.PageNumber > 1) { <a asp-page="Index" asp-route-projectId="@Model.ProjectId" asp-route-env="@Model.Env" asp-route-outcome="@Model.Outcome" asp-route-pageNumber="@(Model.PageNumber - 1)">Trước</a> }
        @if (Model.PageNumber * WebPortal.ControlPlane.FormManagementService.SyncPageSize < Model.Log.Total) { <a asp-page="Index" asp-route-projectId="@Model.ProjectId" asp-route-env="@Model.Env" asp-route-outcome="@Model.Outcome" asp-route-pageNumber="@(Model.PageNumber + 1)">Sau</a> }
    </p>
}

@if (Model.CanImportFor.Count > 0)
{
    <section class="adm__panel">
        <h2>Nhập kết quả áp gói</h2>
        <p class="adm__crumb">Chọn file apply-result-*.json do Cli apply-package xuất. Portal chỉ nhận khi SHA-256 manifest khớp gói đã lưu.</p>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Import" class="adm__bar">
            <select name="project" aria-label="Dự án">
                @foreach (var p in Model.CanImportFor) { <option value="@p.Id">@p.Code</option> }
            </select>
            <input type="file" name="result" accept=".json,application/json" required aria-label="File kết quả" />
            <button type="submit" class="adm__btn">Nhập</button>
        </form>
    </section>
}
