@page
@model WebPortal.Pages.Admin.Forms.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Form";
    ViewData["Crumb"] = "Định nghĩa form API từng dự án: soạn, kiểm, publish";
    ViewData["Nav"] = "forms";
}
<partial name="_Flash" model="@((Model.Flash, Model.FlashError))" />
<div class="adm__bar">
    @foreach (var p in Model.Projects)
    {
        <a class="adm__btn @(p.Id == Model.ProjectId ? "" : "adm__btn--ghost")" asp-page="Index" asp-route-project="@p.Id">@p.Code</a>
    }
    @if (Model.Projects.Count == 0)
    {
        <span class="adm__empty">Bạn chưa có quyền xem form của dự án nào.</span>
    }
</div>
@if (Model.List != null)
{
    @if (Model.List.CanEdit)
    {
        <form method="get" asp-page="Edit" class="adm__bar">
            <input type="hidden" name="project" value="@Model.ProjectId" />
            <input name="form" maxlength="32" placeholder="Tên form mới, vd setSaleInvoice" aria-label="Tên form mới" required />
            <button type="submit" class="adm__btn">Tạo form mới</button>
        </form>
    }
    <table class="adm__table">
        <thead><tr><th>Form</th><th>Revision mới nhất</th><th>Trạng thái</th><th>Đang hiệu lực</th><th>Cập nhật</th><th></th></tr></thead>
        <tbody>
        @foreach (var f in Model.List.Forms)
        {
            <tr>
                <td>@f.Name</td>
                <td>@f.LatestRevision</td>
                <td><span class="adm__chip">@f.LatestStatus</span></td>
                <td>@(f.ActiveRevision?.ToString() ?? "chưa publish")</td>
                <td>@f.UpdatedAt.ToString("yyyy-MM-dd HH:mm") @f.UpdatedBy</td>
                <td><a asp-page="Edit" asp-route-project="@Model.ProjectId" asp-route-form="@f.Name">Mở</a></td>
            </tr>
        }
        @if (Model.List.Forms.Count == 0)
        {
            <tr><td colspan="6" class="adm__empty">Dự án chưa có form nào.</td></tr>
        }
        </tbody>
    </table>
}
