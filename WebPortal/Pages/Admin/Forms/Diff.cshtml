@page
@model WebPortal.Pages.Admin.Forms.DiffModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"So sánh {Model.Form}";
    ViewData["Crumb"] = $"Revision {Model.From} → {Model.To}";
    ViewData["Nav"] = "forms";
}
<partial name="_Flash" model="@((Model.Flash, Model.FlashError))" />
@if (Model.Lines != null)
{
    <pre class="adm__diff">@foreach (var line in Model.Lines)
{
<span class="adm__diff-line adm__diff-@(line.Kind == '+' ? "add" : line.Kind == '-' ? "del" : "same")">@line.Kind @line.Text
</span>}</pre>
}
<p><a asp-page="Edit" asp-route-project="@Model.Project" asp-route-form="@Model.Form">← Quay lại form</a></p>
