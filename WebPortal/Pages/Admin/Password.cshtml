@page
@model WebPortal.Pages.Admin.PasswordModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Crumb"] = "Mật khẩu mới tối thiểu 12 ký tự";
    ViewData["Nav"] = "password";
}
<partial name="_Flash" model="@((Model.Flash, Model.FlashError))" />
<form method="post" class="adm__form" autocomplete="off">
    <label for="Current">Mật khẩu hiện tại</label>
    <input id="Current" name="Current" type="password" maxlength="256" autocomplete="current-password" required />
    <label for="Replacement">Mật khẩu mới</label>
    <input id="Replacement" name="Replacement" type="password" maxlength="256" autocomplete="new-password" required />
    <button type="submit" class="adm__btn">Đổi mật khẩu</button>
</form>
