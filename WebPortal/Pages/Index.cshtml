@page "/"
@model IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Fast API Portal</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="adm adm--login">
    <main class="adm__card">
        <h1 class="adm__title">Fast API Portal</h1>
        <p class="adm__crumb">Portal nội bộ quản trị WebApi các dự án.</p>
        <p>Admin dự án và tài khoản Api: mở đường dẫn theo mã dự án, ví dụ <code>/AQTC</code>.</p>
        <p>Quản trị portal: <a href="/cpanel">/cpanel</a>.</p>
    </main>
</body>
</html>
