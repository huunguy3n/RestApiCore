<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="App_Data\Form\Include\" />
    <Folder Include="App_Data\Structure\Data\" />
    <Folder Include="App_Data\Structure\System\" />
    <Folder Include="Log\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script SQL của DB dự án đi cùng bản phát hành: PortalApp (nằm trong folder này) chạy chúng ở bước Cài đặt -->
    <None Include="..\sql\0*.sql" Link="sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Form XML và Options (Message.xml, Irregular.txt) là một phần của bản phát hành -->
    <None Update="App_Data\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Business\Business.csproj" />
    <ProjectReference Include="..\DataAccess\DataAccess.csproj" />
    <ProjectReference Include="..\Models\Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <Import Project="..\build\Protect.targets" />

</Project>
