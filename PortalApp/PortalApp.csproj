<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Fast.PortalApp</AssemblyName>
    <RootNamespace>PortalApp</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>3.0.0</Version>
    <!-- Control tự vẽ không dùng designer, không cần serialize property -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Cài IIS, ACL và ghi ProgramData cần quyền Administrator -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Bản phát hành: một file exe tự chứa, nén, không PDB (xem build/protect.targets cho bước làm rối + manifest toàn vẹn) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- PortalApp gọi thẳng service dùng chung (không còn CLI) -->
    <ProjectReference Include="..\Business\Business.csproj" />
    <ProjectReference Include="..\DataAccess\DataAccess.csproj" />
    <ProjectReference Include="..\Security\Security.csproj" />
    <ProjectReference Include="..\Models\Models.csproj" />
    <ProjectReference Include="..\Provider\Provider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- PortalApp làm rối cả assembly chính (phần kiểm license nằm ở đây và ở Security) -->
    <ProtectAssemblies>Fast.PortalApp;Business;Security;DataAccess;Provider</ProtectAssemblies>
  </PropertyGroup>
  <Import Project="..\build\Protect.targets" />

</Project>
