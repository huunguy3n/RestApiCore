<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.config CHỈ để Visual Studio nhận project web. KHÔNG chép lên chương trình FBO: FBO dùng Web.config của nó
  (connectionStrings sysConnectionString / appConnectionString), chỉ chép FboWeb.dll vào bin và các file trang
  (xem deploy-fbo.cmd). Không commit chuỗi kết nối vào đây.
-->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <customErrors mode="RemoteOnly" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
  </system.web>
</configuration>
